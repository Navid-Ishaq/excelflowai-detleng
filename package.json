{
  "name": "excelflowai-detleng",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5180",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.mjs && node tests/extra-browser.mjs && node tests/analysis-browser.mjs",
    "test:live": "node tests/live-browser.mjs && node tests/live-edge-browser.mjs",
    "test:performance": "node tests/live-performance.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:builder": "node tests/builder-browser.mjs",
    "test:experiences": "node tests/guide-browser.mjs && node tests/story-browser.mjs",
    "test:roles": "node tests/roles-browser.mjs",
    "check": "node --check src/app.js",
    "test:e2e": "npm run test:browser && npm run test:live && npm run test:builder && npm run test:experiences && npm run test:roles"
  },
  "dependencies": {
    "chart.js": "4.5.1",
    "exceljs": "4.4.0",
    "jszip": "3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "axe-core": "4.14.0",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "optionalDependencies": {
    "@esbuild/win32-x64": "0.28.2",
    "@rollup/rollup-win32-x64-msvc": "4.64.7"
  }
}
